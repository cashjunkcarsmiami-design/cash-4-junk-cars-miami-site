{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/thank-you",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/thank-you.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "redirects": [
    {"source":"/blog/los-5-errores-al-vender-tu-carro-al-rastro-en-miami","destination":"/compare-complete-junk-car-offers-miami","permanent":true},
    {"source":"/blog/c-mo-vender-mi-carro-viejo-en-miami-por-cash-hoy-mismo.html","destination":"/first-phone-call-junk-car-offer-miami","permanent":true},
    {"source":"/blog/c-mo-vender-mi-carro-viejo-en-miami-por-cash-hoy-mismo","destination":"/first-phone-call-junk-car-offer-miami","permanent":true},
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cash-4-junk-cars-miami.com"
        }
      ],
      "destination": "https://cash-4-junk-cars-miami.com/:path*",
      "permanent": true
    }
  ]
}
